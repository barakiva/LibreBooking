#!/usr/bin/bash

set -euo pipefail

apachectl -M | grep -q headers_module || a2enmod headers
apachectl -M | grep -q rewrite_module || a2enmod rewrite


composer install
mkdir -p ./tpl_c

sudo chown -R www-data:www-data ./tpl_c
sudo chmod -R 755 ./tpl
sudo chmod -R 755 ./tpl_c
sudo chmod -R 755 ./uploads

# Config
cp ./config/config.dist.php ./config/config.php
CFG_FILE="./config/config.php"
DB_TYPE="mysql"
DB_HOST="127.0.0.1"
DB_NAME="librebooking"
DB_USER="lb_user"
DB_PASS="password"
INSTALL_PASS="verysecuresecret"
# Update lines in-place
sed -i -E "s/('type'\s*=>\s*)'[^']*'/\1'$DB_TYPE'/"     "$CFG_FILE"
sed -i -E "s/('hostspec'\s*=>\s*)'[^']*'/\1'$DB_HOST'/" "$CFG_FILE"
sed -i -E "s/('name'\s*=>\s*)'[^']*'/\1'$DB_NAME'/"     "$CFG_FILE"
sed -i -E "s/('user'\s*=>\s*)'[^']*'/\1'$DB_USER'/"     "$CFG_FILE"
sed -i -E "s/('password'\s*=>\s*)'[^']*'/\1'$DB_PASS'/" "$CFG_FILE"
# Install password
sed -i -E "s/('install\.password'\s*=>\s*)'[^']*'/\1'$INSTALL_PASS'/" "$CFG_FILE"


# --- Apache reload ---
sudo systemctl reload apache2 || sudo systemctl restart apache2
sudo docker compose up -d
for f in ./database_schema/*.sql; do
  docker exec -i librebooking-mdb mysql -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" < "$f"
done
DB_VERSION=$(docker exec -i librebooking-mdb mysql -u "$DB_USER" -p"$DB_PASS" -N -e "SELECT version FROM schema_version ORDER BY version DESC LIMIT 1;" "$DB_NAME")
echo "Current DB version: $DB_VERSION"

find ./database_schema/upgrade -type f -name '*.sql' | sort | while read -r f; do
  # Extract version from filename, assuming format like 'V2__desc.sql' or '2.sql'
  VERSION=$(basename "$f" | grep -oE '^[0-9]+' || true)
  if [[ -n "$VERSION" && "$VERSION" -gt "$DB_VERSION" ]]; then
    echo "Applying migration $f (version $VERSION)"
    docker exec -i librebooking-mdb mysql -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" < "$f"
  else
    echo "Skipping $f (version $VERSION <= $DB_VERSION)"
  fi
done
echo "✅ Installation complete"
